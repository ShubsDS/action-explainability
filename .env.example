# Copy to .env (git-ignored) and fill in. Never commit .env, never log its values.
#
# Our config.py loads THIS repo's .env before importing upstream; upstream's own
# loader (scripts/common.py) never overrides variables already set, so values here win.
# Do not create upstream/.env.

# Tinker: sampling (and, in Phase 2 only, training)
TINKER_API_KEY=

# OpenRouter: monitors, silence judges, admission scorer, C5 outside reader
OPENROUTER_API_KEY=

# Only for SFT data generation / stance judge; not needed in Phase 1
# ANTHROPIC_API_KEY=

# Grading sandbox. MUST be docker: td.grading refuses anything else (handoff rule 4).
RH_SANDBOX_BACKEND=docker
# Corrected code extractor (the default upstream; set explicitly so it is logged).
RH_CODE_EXTRACTOR=fixed

# Where paid rollouts and judgements are written (default: ./data)
# TD_DATA_DIR=
